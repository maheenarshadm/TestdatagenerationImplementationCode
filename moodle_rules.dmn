<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="moodle_rules_10_tables_50_rules" name="Moodle Rules 10 Tables 50 Rules" namespace="http://camunda.org/schema/1.0/dmn/moodle-rules">
  <decision id="DT1_EnrolmentValidity" name="DT1_EnrolmentValidity">
    <description>Decision table generated from JSON rules for DT1_EnrolmentValidity.</description>
    <decisionTable id="DT1_EnrolmentValidity_table" hitPolicy="FIRST">
      <input id="DT1_EnrolmentValidity_input_1" label="userConfirmed">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_1" typeRef="number">
          <text>userConfirmed</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_2" label="enrolStatus">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_2" typeRef="number">
          <text>enrolStatus</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_3" label="courseVisible">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_3" typeRef="number">
          <text>courseVisible</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_4" label="daysUntilEnrolExpiry">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_4" typeRef="number">
          <text>daysUntilEnrolExpiry</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_5" label="daysSinceEnrolment">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_5" typeRef="number">
          <text>daysSinceEnrolment</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_6" label="enrolPeriodDays">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_6" typeRef="number">
          <text>enrolPeriodDays</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_7" label="moduleCompletionCount">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_7" typeRef="number">
          <text>moduleCompletionCount</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_8" label="timecompleted">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_8" typeRef="number">
          <text>timecompleted</text>
        </inputExpression>
      </input>
      <input id="DT1_EnrolmentValidity_input_9" label="moduleCompletionPct">
        <inputExpression id="DT1_EnrolmentValidity_inputExpr_9" typeRef="number">
          <text>moduleCompletionPct</text>
        </inputExpression>
      </input>
      <output id="DT1_EnrolmentValidity_output" label="enrolmentStatus" name="enrolmentStatus" typeRef="string"/>
      <rule id="enrol_ACTIVE_FULL">
        <description>Fully active enrolment within period - Student has a confirmed, active enrolment with substantial time remaining and the course is open. Requires user confirmed, enrolment active, course visible, days until expiry adequate, and enrolment age meaningful.</description>
        <inputEntry id="enrol_ACTIVE_FULL_input_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_4">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_5">
          <text>&gt;= 7</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_6">
          <text>&gt;= 90</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_FULL_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="enrol_ACTIVE_FULL_output">
          <text>"ACTIVE_FULL"</text>
        </outputEntry>
      </rule>
      <rule id="enrol_ACTIVE_EXPIRING">
        <description>Active enrolment approaching expiry - Enrolment is valid and active but within the final 30-day window. Triggers renewal prompt. Student must have actually started (daysSinceEnrolment &gt; 0) and have some module activity.</description>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_5">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_7">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_ACTIVE_EXPIRING_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="enrol_ACTIVE_EXPIRING_output">
          <text>"ACTIVE_EXPIRING"</text>
        </outputEntry>
      </rule>
      <rule id="enrol_SUSPENDED_ADMIN">
        <description>Enrolment administratively suspended - User account or enrolment has been suspended by admin (status=1). Student was previously active (had some completions) but access is now blocked.</description>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_7">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_SUSPENDED_ADMIN_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="enrol_SUSPENDED_ADMIN_output">
          <text>"SUSPENDED_ADMIN"</text>
        </outputEntry>
      </rule>
      <rule id="enrol_EXPIRED_NO_COMPLETION">
        <description>Enrolment expired without course completion - Enrolment period has ended (daysUntilEnrolExpiry &lt; 0) and the student never reached a completion event. Module completion below threshold and no completion timestamp recorded.</description>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_4">
          <text>&lt; 0</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_5">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_8">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_EXPIRED_NO_COMPLETION_input_9">
          <text>&lt; 80</text>
        </inputEntry>
        <outputEntry id="enrol_EXPIRED_NO_COMPLETION_output">
          <text>"EXPIRED_NO_COMPLETION"</text>
        </outputEntry>
      </rule>
      <rule id="enrol_PENDING_UNCONFIRMED">
        <description>Enrolment pending email confirmation - User has enrolled but not confirmed email. Course is visible and enrolment was just created. Cannot access full course materials until confirmed.</description>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_5">
          <text>&lt;= 3</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="enrol_PENDING_UNCONFIRMED_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="enrol_PENDING_UNCONFIRMED_output">
          <text>"PENDING_UNCONFIRMED"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT2_AssignmentCompleteness" name="DT2_AssignmentCompleteness">
    <description>Decision table generated from JSON rules for DT2_AssignmentCompleteness.</description>
    <decisionTable id="DT2_AssignmentCompleteness_table" hitPolicy="FIRST">
      <input id="DT2_AssignmentCompleteness_input_1" label="unsubmittedCount">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_1" typeRef="number">
          <text>unsubmittedCount</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_2" label="submittedLate">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_2" typeRef="number">
          <text>submittedLate</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_3" label="avgAssignGrade">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_3" typeRef="number">
          <text>avgAssignGrade</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_4" label="maxAttemptNumber">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_4" typeRef="number">
          <text>maxAttemptNumber</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_5" label="assignPenaltyActive">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_5" typeRef="number">
          <text>assignPenaltyActive</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_6" label="totalAssignments">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_6" typeRef="number">
          <text>totalAssignments</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_7" label="submittedOnTime">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_7" typeRef="number">
          <text>submittedOnTime</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_8" label="daysSinceEnrolment">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_8" typeRef="number">
          <text>daysSinceEnrolment</text>
        </inputExpression>
      </input>
      <input id="DT2_AssignmentCompleteness_input_9" label="overriddenGradeCount">
        <inputExpression id="DT2_AssignmentCompleteness_inputExpr_9" typeRef="number">
          <text>overriddenGradeCount</text>
        </inputExpression>
      </input>
      <output id="DT2_AssignmentCompleteness_output" label="assignCompliance" name="assignCompliance" typeRef="string"/>
      <rule id="assign_FULLY_COMPLIANT">
        <description>All assignments submitted on time with passing grades - Student submitted all course assignments before deadlines, achieved passing grades on average, no resubmission attempts beyond first, and no penalty markers. Strongest compliance outcome.</description>
        <inputEntry id="assign_FULLY_COMPLIANT_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_3">
          <text>&gt;= 60</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_4">
          <text>1</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_6">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_FULLY_COMPLIANT_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="assign_FULLY_COMPLIANT_output">
          <text>"FULLY_COMPLIANT"</text>
        </outputEntry>
      </rule>
      <rule id="assign_LATE_PASS">
        <description>All submitted but some late, still passing - Student has submitted all assignments (none missing) but at least one was submitted after the deadline. Grade is still passing despite late penalties. Requires penalty was applied.</description>
        <inputEntry id="assign_LATE_PASS_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_2">
          <text>&lt;= 3</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_3">
          <text>&gt;= 50</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_6">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_LATE_PASS_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="assign_LATE_PASS_output">
          <text>"LATE_PASS"</text>
        </outputEntry>
      </rule>
      <rule id="assign_INCOMPLETE_RESUBMITTING">
        <description>Incomplete — actively resubmitting with multiple attempts - Student has missing assignments but is still actively working (multiple attempt numbers recorded, recent modifications). Not yet at academic risk but needs monitoring.</description>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_1">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_3">
          <text>&lt; 60</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_4">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_6">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_7">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_INCOMPLETE_RESUBMITTING_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="assign_INCOMPLETE_RESUBMITTING_output">
          <text>"INCOMPLETE_RESUBMITTING"</text>
        </outputEntry>
      </rule>
      <rule id="assign_NON_SUBMISSION_RISK">
        <description>Multiple missing submissions — academic risk - Two or more assignments not submitted, no late submissions recorded (student did not even attempt late), and average grade on submitted work is below pass mark. High risk of course failure.</description>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_1">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_3">
          <text>&lt; 50</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_6">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_8">
          <text>&gt;= 21</text>
        </inputEntry>
        <inputEntry id="assign_NON_SUBMISSION_RISK_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="assign_NON_SUBMISSION_RISK_output">
          <text>"NON_SUBMISSION_RISK"</text>
        </outputEntry>
      </rule>
      <rule id="assign_GRADE_OVERRIDE_REVIEW">
        <description>Grade manually overridden — requires review - One or more assignment grades have been manually overridden by an instructor, which is unusual. Student has completed all assignments and achieved passing average, but overrides require audit.</description>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_3">
          <text>&gt;= 50</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_6">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_7">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="assign_GRADE_OVERRIDE_REVIEW_input_9">
          <text>&gt;= 1</text>
        </inputEntry>
        <outputEntry id="assign_GRADE_OVERRIDE_REVIEW_output">
          <text>"GRADE_OVERRIDE_REVIEW"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT3_QuizPerformanceBand" name="DT3_QuizPerformanceBand">
    <description>Decision table generated from JSON rules for DT3_QuizPerformanceBand.</description>
    <decisionTable id="DT3_QuizPerformanceBand_table" hitPolicy="FIRST">
      <input id="DT3_QuizPerformanceBand_input_1" label="avgQuizScore">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_1" typeRef="number">
          <text>avgQuizScore</text>
        </inputExpression>
      </input>
      <input id="DT3_QuizPerformanceBand_input_2" label="quizPassCount">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_2" typeRef="number">
          <text>quizPassCount</text>
        </inputExpression>
      </input>
      <input id="DT3_QuizPerformanceBand_input_3" label="quizAttemptCount">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_3" typeRef="number">
          <text>quizAttemptCount</text>
        </inputExpression>
      </input>
      <input id="DT3_QuizPerformanceBand_input_4" label="quizMaxAllowed">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_4" typeRef="number">
          <text>quizMaxAllowed</text>
        </inputExpression>
      </input>
      <input id="DT3_QuizPerformanceBand_input_5" label="daysSinceEnrolment">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_5" typeRef="number">
          <text>daysSinceEnrolment</text>
        </inputExpression>
      </input>
      <input id="DT3_QuizPerformanceBand_input_6" label="moduleCompletionCount">
        <inputExpression id="DT3_QuizPerformanceBand_inputExpr_6" typeRef="number">
          <text>moduleCompletionCount</text>
        </inputExpression>
      </input>
      <output id="DT3_QuizPerformanceBand_output" label="quizBand" name="quizBand" typeRef="string"/>
      <rule id="quiz_MASTERY">
        <description>Quiz mastery — high scores with few attempts - Student demonstrates mastery: high average score, all quiz attempts passed, well below maximum allowed attempts. Indicates strong conceptual understanding without needing retries.</description>
        <inputEntry id="quiz_MASTERY_input_1">
          <text>&gt;= 75</text>
        </inputEntry>
        <inputEntry id="quiz_MASTERY_input_2">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="quiz_MASTERY_input_3">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="quiz_MASTERY_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_MASTERY_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_MASTERY_input_6">
          <text>-</text>
        </inputEntry>
        <outputEntry id="quiz_MASTERY_output">
          <text>"MASTERY"</text>
        </outputEntry>
      </rule>
      <rule id="quiz_PASS_WITH_RETRIES">
        <description>Passed quizzes but required multiple attempts - Student eventually passed quizzes but exhausted or nearly exhausted allowed attempts. Passed count equals attempt count (every attempt eventually passed) but attempt count is high.</description>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_1">
          <text>&lt; 75</text>
        </inputEntry>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_2">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_3">
          <text>&lt;= quizMaxAllowed</text>
        </inputEntry>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_PASS_WITH_RETRIES_input_6">
          <text>-</text>
        </inputEntry>
        <outputEntry id="quiz_PASS_WITH_RETRIES_output">
          <text>"PASS_WITH_RETRIES"</text>
        </outputEntry>
      </rule>
      <rule id="quiz_ATTEMPTS_EXHAUSTED_FAIL">
        <description>All attempts used — never reached pass mark - Student has used all allowed quiz attempts (quizAttemptCount &gt;= quizMaxAllowed) but quiz pass count is zero or low. Average score well below passing. Requires remediation.</description>
        <inputEntry id="quiz_ATTEMPTS_EXHAUSTED_FAIL_input_1">
          <text>&lt; 50</text>
        </inputEntry>
        <inputEntry id="quiz_ATTEMPTS_EXHAUSTED_FAIL_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="quiz_ATTEMPTS_EXHAUSTED_FAIL_input_3">
          <text>&gt;= quizMaxAllowed</text>
        </inputEntry>
        <inputEntry id="quiz_ATTEMPTS_EXHAUSTED_FAIL_input_4">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="quiz_ATTEMPTS_EXHAUSTED_FAIL_input_5">
          <text>-</text>
