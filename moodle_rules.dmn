        <inputEntry id="forum_INSTRUCTOR_RESPONSE_NEEDED_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_INSTRUCTOR_RESPONSE_NEEDED_input_5">
          <text>-</text>
