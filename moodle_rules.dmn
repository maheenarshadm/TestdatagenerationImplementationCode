          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_INTEGRITY_HOLD_input_8">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="standing_INTEGRITY_HOLD_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_INTEGRITY_HOLD_input_10">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="standing_INTEGRITY_HOLD_input_11">
          <text>&gt;= 70</text>
        </inputEntry>
        <inputEntry id="standing_INTEGRITY_HOLD_input_12">
          <text>&gt;= 2</text>
        </inputEntry>
