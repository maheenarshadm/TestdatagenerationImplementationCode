      <rule id="completion_AWARDED">
        <description>Course completion awarded - Student meets all completion requirements: passing final grade, all required modules completed, all assignments submitted, course completion record written. Certificate can be issued.</description>
        <inputEntry id="completion_AWARDED_input_1">
          <text>&gt;= gradePassMark</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_2">
          <text>&gt;= 90</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_4">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_6">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_AWARDED_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="completion_AWARDED_output">
          <text>"AWARDED"</text>
        </outputEntry>
      </rule>
      <rule id="completion_ELIGIBLE_PENDING">
        <description>Met grade requirements but completion not yet recorded - Student has achieved passing grade and high module completion, but the mdl_course_completions.timecompleted has not yet been written (reaggregate may be pending). System should trigger reaggregation.</description>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_1">
          <text>&gt;= gradePassMark</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_2">
          <text>&gt;= 85</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_6">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_7">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="completion_ELIGIBLE_PENDING_input_8">
          <text>-</text>
