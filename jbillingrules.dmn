        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_4">
          <text>-</text>
