        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_4" label="daysSinceEnrolment">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_4" typeRef="number">
          <text>daysSinceEnrolment</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_5" label="quizAttemptCount">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_5" typeRef="number">
          <text>quizAttemptCount</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_6" label="unsubmittedCount">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_6" typeRef="number">
          <text>unsubmittedCount</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_7" label="unansweredDiscussionCount">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_7" typeRef="number">
