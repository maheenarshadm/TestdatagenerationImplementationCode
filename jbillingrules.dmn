        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_6">
          <text>1</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="payout_ELIGIBLE_AUTO_outputEntry_1">
          <text>"ELIGIBLE_AUTO"</text>
        </outputEntry>
        <annotationEntry id="payout_ELIGIBLE_AUTO_annotation_1">
          <text>Partner eligible for automatic payout processing — Partner account has a positive balance, a due payout amount is calculated, automatic processing is enabled, the payout period has ended, and the customer linked to the partner is in good standing (not overdue). Payout can be processed automatically.</text>
        </annotationEntry>
      </rule>
      <rule id="payout_ELIGIBLE_MANUAL">
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_2">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_4">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_6">
          <text>1</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_MANUAL_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="payout_ELIGIBLE_MANUAL_outputEntry_1">
          <text>"ELIGIBLE_MANUAL"</text>
        </outputEntry>
        <annotationEntry id="payout_ELIGIBLE_MANUAL_annotation_1">
          <text>Partner eligible for manual payout — automatic disabled — Partner has earned a positive payout and the period has ended, but automatic processing is disabled. Payout must be manually approved and initiated. Customer account is in good standing.</text>
        </annotationEntry>
      </rule>
      <rule id="payout_HELD_CUSTOMER_OVERDUE">
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_2">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_4">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_8">
          <text>&gt;= 100</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_9">
          <text>0</text>
        </inputEntry>
        <inputEntry id="payout_HELD_CUSTOMER_OVERDUE_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="payout_HELD_CUSTOMER_OVERDUE_outputEntry_1">
          <text>"HELD_CUSTOMER_OVERDUE"</text>
        </outputEntry>
        <annotationEntry id="payout_HELD_CUSTOMER_OVERDUE_annotation_1">
          <text>Payout held — linked customer account overdue — Partner has earned a payout and the period has ended, but the linked customer account has overdue invoices. Payout is held until the customer's account is brought current to prevent partner from receiving funds while their account is delinquent.</text>
        </annotationEntry>
      </rule>
      <rule id="payout_ANOMALY_ZERO_BALANCE">
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_1">
          <text>&lt;= 0</text>
        </inputEntry>
