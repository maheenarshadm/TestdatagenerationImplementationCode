        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_9">
          <text>0</text>
        </inputEntry>
        <inputEntry id="payout_ANOMALY_ZERO_BALANCE_inputEntry_10">
          <text>&gt;= 1</text>
        </inputEntry>
        <outputEntry id="payout_ANOMALY_ZERO_BALANCE_outputEntry_1">
          <text>"ANOMALY_ZERO_BALANCE"</text>
        </outputEntry>
        <annotationEntry id="payout_ANOMALY_ZERO_BALANCE_annotation_1">
          <text>Payout anomaly — due payout with zero partner balance — System has calculated a due payout amount but the partner's recorded balance is zero or negative. This is a data inconsistency: payouts cannot exceed the balance. Requires manual investigation before processing.</text>
        </annotationEntry>
      </rule>
      <rule id="payout_NOT_DUE">
        <inputEntry id="payout_NOT_DUE_inputEntry_1">
          <text>-</text>
        </inputEntry>
