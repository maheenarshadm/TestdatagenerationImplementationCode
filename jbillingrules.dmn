        <inputEntry id="order_READY_POSTPAID_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_13">
          <text>-</text>
        </inputEntry>
        <outputEntry id="order_READY_POSTPAID_outputEntry_1">
          <text>"READY_POSTPAID"</text>
        </outputEntry>
        <annotationEntry id="order_READY_POSTPAID_annotation_1">
          <text>Postpaid order ready for billing cycle — Active postpaid order with at least one active order line, billing date has passed (daysToNextBill &lt;= 0), customer account is active, and no overdue balance blocking processing. Ready to generate invoice.</text>
        </annotationEntry>
      </rule>
      <rule id="order_READY_PREPAID">
        <inputEntry id="order_READY_PREPAID_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_3">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_8">
          <text>&gt; orderLineTotal</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_PREPAID_inputEntry_13">
          <text>-</text>
        </inputEntry>
        <outputEntry id="order_READY_PREPAID_outputEntry_1">
          <text>"READY_PREPAID"</text>
        </outputEntry>
        <annotationEntry id="order_READY_PREPAID_annotation_1">
          <text>Prepaid order ready — sufficient balance — Active prepaid order with billing date passed and customer has sufficient prepaid balance to cover the order line total. Autopay topped up balance. Safe to process next billing period.</text>
        </annotationEntry>
      </rule>
      <rule id="order_BLOCKED_OVERDUE">
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_3">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_7">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_9">
          <text>&gt;= 100</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_BLOCKED_OVERDUE_inputEntry_13">
          <text>-</text>
        </inputEntry>
        <outputEntry id="order_BLOCKED_OVERDUE_outputEntry_1">
          <text>"BLOCKED_OVERDUE"</text>
        </outputEntry>
        <annotationEntry id="order_BLOCKED_OVERDUE_annotation_1">
          <text>Order blocked — customer has unresolved overdue invoices — Order is active and billing date has passed but the customer has multiple overdue invoices preventing new invoice generation. Billing system should hold the order until overdue balance is resolved.</text>
        </annotationEntry>
      </rule>
      <rule id="order_INSUFFICIENT_BALANCE">
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_3">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_8">
          <text>&lt;= orderLineTotal</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_10">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_INSUFFICIENT_BALANCE_inputEntry_13">
          <text>-</text>
        </inputEntry>
        <outputEntry id="order_INSUFFICIENT_BALANCE_outputEntry_1">
          <text>"INSUFFICIENT_BALANCE"</text>
        </outputEntry>
        <annotationEntry id="order_INSUFFICIENT_BALANCE_annotation_1">
          <text>Prepaid order blocked — insufficient balance — Prepaid order billing date has arrived but customer's dynamic balance is insufficient to cover order line total. Autopay either failed or is not configured. Order is held pending top-up.</text>
        </annotationEntry>
      </rule>
      <rule id="order_EXPIRING_NO_RENEWAL">
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_11">
          <text>[0..7]</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_12">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_EXPIRING_NO_RENEWAL_inputEntry_13">
          <text>0</text>
        </inputEntry>
        <outputEntry id="order_EXPIRING_NO_RENEWAL_outputEntry_1">
          <text>"EXPIRING_NO_RENEWAL"</text>
        </outputEntry>
        <annotationEntry id="order_EXPIRING_NO_RENEWAL_annotation_1">
          <text>Order expiring with no renewal scheduled — Active order is within 7 days of expiry, no renewal order exists (renewalOrderCount = 0), and autopay is not enabled. Customer has not initiated renewal. Service interruption risk unless action taken.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT4_PaymentProcessing" name="DT4_PaymentProcessing">
    <decisionTable id="DT4_PaymentProcessing_table" hitPolicy="FIRST">
      <input id="DT4_PaymentProcessing_input_1" label="resultId">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_1" typeRef="number">
          <text>resultId</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_2" label="isRefund">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_2" typeRef="number">
          <text>isRefund</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_3" label="autoPayment">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_3" typeRef="number">
          <text>autoPayment</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_4" label="invoicesClearedCount">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_4" typeRef="number">
          <text>invoicesClearedCount</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_5" label="deleted">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_5" typeRef="number">
          <text>deleted</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_6" label="paymentAmount">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_6" typeRef="number">
          <text>paymentAmount</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_7" label="paymentAttemptCount">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_7" typeRef="number">
          <text>paymentAttemptCount</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_8" label="paymentMethodValid">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_8" typeRef="number">
          <text>paymentMethodValid</text>
        </inputExpression>
      </input>
      <input id="DT4_PaymentProcessing_input_9" label="maxPaymentRetries">
        <inputExpression id="DT4_PaymentProcessing_inputExpression_9" typeRef="number">
          <text>maxPaymentRetries</text>
        </inputExpression>
      </input>
      <output id="DT4_PaymentProcessing_output_1" name="paymentOutcome" label="paymentOutcome" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="pay_SUCCESSFUL_AUTO">
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_6">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_SUCCESSFUL_AUTO_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="pay_SUCCESSFUL_AUTO_outputEntry_1">
          <text>"SUCCESSFUL_AUTO"</text>
        </outputEntry>
        <annotationEntry id="pay_SUCCESSFUL_AUTO_annotation_1">
          <text>Successful automatic payment — invoice cleared — Payment was processed successfully via autopay (credit card or ACH), result is successful, at least one invoice was cleared by this payment, and no refund flag. Reconciliation can proceed.</text>
        </annotationEntry>
      </rule>
      <rule id="pay_FAILED_RETRY_ELIGIBLE">
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_7">
          <text>&lt; maxPaymentRetries and &gt;= 1</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_RETRY_ELIGIBLE_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="pay_FAILED_RETRY_ELIGIBLE_outputEntry_1">
          <text>"FAILED_RETRY_ELIGIBLE"</text>
        </outputEntry>
        <annotationEntry id="pay_FAILED_RETRY_ELIGIBLE_annotation_1">
          <text>Failed payment — within retry attempt threshold — Payment failed (result = failed or processor unavailable) but the number of attempts so far is within the configured retry limit. Payment method is still valid. System should schedule a retry.</text>
        </annotationEntry>
      </rule>
      <rule id="pay_FAILED_MAX_RETRIES">
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_4">
          <text>&gt;= 0</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_7">
          <text>&gt;= maxPaymentRetries</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_FAILED_MAX_RETRIES_inputEntry_9">
          <text>&gt;= 2</text>
        </inputEntry>
        <outputEntry id="pay_FAILED_MAX_RETRIES_outputEntry_1">
          <text>"FAILED_MAX_RETRIES"</text>
        </outputEntry>
        <annotationEntry id="pay_FAILED_MAX_RETRIES_annotation_1">
          <text>Payment failed — maximum retries exhausted — Payment has failed and all configured retry attempts have been used. Payment method may be invalid or funds unavailable. Account should be flagged and dunning escalation triggered.</text>
        </annotationEntry>
      </rule>
      <rule id="pay_REFUND_ISSUED">
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_6">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <inputEntry id="pay_REFUND_ISSUED_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="pay_REFUND_ISSUED_outputEntry_1">
          <text>"REFUND_ISSUED"</text>
        </outputEntry>
        <annotationEntry id="pay_REFUND_ISSUED_annotation_1">
          <text>Refund successfully issued — A refund payment was processed successfully: result is successful, isRefund flag is set, refund amount is positive, and at least one original invoice is linked. Customer balance should be updated accordingly.</text>
        </annotationEntry>
      </rule>
      <rule id="pay_MANUAL_PENDING_MATCH">
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_1">
          <text>4</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_6">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="pay_MANUAL_PENDING_MATCH_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="pay_MANUAL_PENDING_MATCH_outputEntry_1">
          <text>"MANUAL_PENDING_MATCH"</text>
        </outputEntry>
        <annotationEntry id="pay_MANUAL_PENDING_MATCH_annotation_1">
          <text>Manual payment entered — awaiting invoice matching — Payment has been manually entered by a billing agent (result = entered, not via autopay), but no invoice has been matched to it yet. Payment amount is positive. Requires manual reconciliation step.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT5_DunningEscalation" name="DT5_DunningEscalation">
    <decisionTable id="DT5_DunningEscalation_table" hitPolicy="FIRST">
      <input id="DT5_DunningEscalation_input_1" label="overdueInvoiceCount">
        <inputExpression id="DT5_DunningEscalation_inputExpression_1" typeRef="number">
          <text>overdueInvoiceCount</text>
        </inputExpression>
      </input>
      <input id="DT5_DunningEscalation_input_2" label="userStatusId">
        <inputExpression id="DT5_DunningEscalation_inputExpression_2" typeRef="number">
          <text>userStatusId</text>
        </inputExpression>
      </input>
      <input id="DT5_DunningEscalation_input_3" label="accountLocked">
        <inputExpression id="DT5_DunningEscalation_inputExpression_3" typeRef="number">
          <text>accountLocked</text>
        </inputExpression>
