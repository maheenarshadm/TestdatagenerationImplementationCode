        <inputEntry id="completion_ELIGIBLE_PENDING_input_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="completion_ELIGIBLE_PENDING_output">
          <text>"ELIGIBLE_PENDING"</text>
        </outputEntry>
      </rule>
      <rule id="completion_IN_PROGRESS_ON_TRACK">
        <description>In progress and on track for completion - Student is actively progressing: significant module completion, passing grade trajectory, assignments being submitted, and within enrolment window. No intervention needed.</description>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_1">
          <text>&gt;= gradePassMark</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_2">
          <text>&lt; 90</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_3">
          <text>&lt;= 1</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_8">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="completion_IN_PROGRESS_ON_TRACK_input_9">
          <text>&gt;= 2</text>
        </inputEntry>
        <outputEntry id="completion_IN_PROGRESS_ON_TRACK_output">
          <text>"IN_PROGRESS_ON_TRACK"</text>
        </outputEntry>
      </rule>
      <rule id="completion_AT_RISK_LOW_ACTIVITY">
        <description>At risk — insufficient activity for completion - Enrolment has been active for some time but module completion is very low, no forum engagement, and grade is below passing. Intervention required to prevent dropout.</description>
        <inputEntry id="completion_AT_RISK_LOW_ACTIVITY_input_1">
          <text>&lt; gradePassMark</text>
        </inputEntry>
        <inputEntry id="completion_AT_RISK_LOW_ACTIVITY_input_2">
          <text>&lt; 40</text>
        </inputEntry>
        <inputEntry id="completion_AT_RISK_LOW_ACTIVITY_input_3">
