      <rule id="med_CLEAN_PROCESSED">
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_3">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_CLEAN_PROCESSED_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="med_CLEAN_PROCESSED_outputEntry_1">
          <text>"CLEAN_PROCESSED"</text>
        </outputEntry>
        <annotationEntry id="med_CLEAN_PROCESSED_annotation_1">
          <text>Mediation record fully processed — no errors — Mediation record has been fully processed: status is done, zero error lines, all lines successfully resolved to orders or invoices, and at least a minimum number of lines were present. No manual intervention required.</text>
        </annotationEntry>
      </rule>
      <rule id="med_PARTIAL_ERRORS">
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_1">
          <text>3</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_2">
          <text>&gt;= 1 and &lt; totalLineCount</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_3">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_PARTIAL_ERRORS_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="med_PARTIAL_ERRORS_outputEntry_1">
          <text>"PARTIAL_ERRORS"</text>
        </outputEntry>
        <annotationEntry id="med_PARTIAL_ERRORS_annotation_1">
          <text>Mediation record partially processed — some error lines — Mediation record processing is complete but some lines failed (error count &gt; 0 and &lt; total lines). Some orders were successfully resolved. Partial revenue impact — error lines need manual review.</text>
        </annotationEntry>
      </rule>
      <rule id="med_FULL_ERROR">
        <inputEntry id="med_FULL_ERROR_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_2">
          <text>totalLineCount</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_FULL_ERROR_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="med_FULL_ERROR_outputEntry_1">
          <text>"FULL_ERROR"</text>
        </outputEntry>
        <annotationEntry id="med_FULL_ERROR_annotation_1">
          <text>Mediation record fully failed — all lines in error — Every line in the mediation record is in error status: errorLineCount equals totalLineCount. No orders were resolved from this record. Revenue leakage risk — entire record must be reprocessed or written off.</text>
        </annotationEntry>
      </rule>
      <rule id="med_DUPLICATE_DETECTED">
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_7">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_DUPLICATE_DETECTED_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="med_DUPLICATE_DETECTED_outputEntry_1">
          <text>"DUPLICATE_DETECTED"</text>
        </outputEntry>
        <annotationEntry id="med_DUPLICATE_DETECTED_annotation_1">
          <text>Mediation record duplicate — key already processed — Mediation record has a jBilling key that already exists in a previously processed record (duplicateKeyCount &gt; 0). Record is in error state. Duplicate usage data must not be billed twice.</text>
        </annotationEntry>
      </rule>
      <rule id="med_REVENUE_LEAKAGE_RISK">
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_2">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_3">
          <text>&gt;= 5</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <inputEntry id="med_REVENUE_LEAKAGE_RISK_inputEntry_9">
          <text>&gt;= 200</text>
        </inputEntry>
        <outputEntry id="med_REVENUE_LEAKAGE_RISK_outputEntry_1">
          <text>"REVENUE_LEAKAGE_RISK"</text>
        </outputEntry>
        <annotationEntry id="med_REVENUE_LEAKAGE_RISK_annotation_1">
          <text>Mediation revenue leakage — high error volume on active customer — Mediation record has many error lines on an active, large-balance customer account. The combination of high error count and large overdue or active balance means significant revenue is at risk of not being billed correctly.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT8_BillingProcessHealth" name="DT8_BillingProcessHealth">
    <decisionTable id="DT8_BillingProcessHealth_table" hitPolicy="FIRST">
      <input id="DT8_BillingProcessHealth_input_1" label="invoicesGenerated">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_1" typeRef="number">
          <text>invoicesGenerated</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_2" label="failedInvoiceCount">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_2" typeRef="number">
          <text>failedInvoiceCount</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_3" label="runCompleted">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_3" typeRef="number">
          <text>runCompleted</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_4" label="runDurationMinutes">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_4" typeRef="number">
          <text>runDurationMinutes</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_5" label="isReviewRun">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_5" typeRef="number">
          <text>isReviewRun</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_6" label="invoicesProcessed">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_6" typeRef="number">
          <text>invoicesProcessed</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_7" label="activeOrderLineCount">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_7" typeRef="number">
          <text>activeOrderLineCount</text>
        </inputExpression>
      </input>
      <input id="DT8_BillingProcessHealth_input_8" label="userStatusId">
        <inputExpression id="DT8_BillingProcessHealth_inputExpression_8" typeRef="number">
          <text>userStatusId</text>
        </inputExpression>
      </input>
      <output id="DT8_BillingProcessHealth_output_1" name="billingProcessHealth" label="billingProcessHealth" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="bproc_SUCCESSFUL_RUN">
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_1">
          <text>&gt; 0 and &gt;= invoicesProcessed</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_4">
          <text>&lt;= 240</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_SUCCESSFUL_RUN_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="bproc_SUCCESSFUL_RUN_outputEntry_1">
          <text>"SUCCESSFUL_RUN"</text>
        </outputEntry>
        <annotationEntry id="bproc_SUCCESSFUL_RUN_annotation_1">
          <text>Billing process run completed successfully — Billing process run has finished with invoices generated matching the expected count, no failed invoices, run completed within the same day it started, and entity is active. Process health is nominal.</text>
        </annotationEntry>
      </rule>
      <rule id="bproc_REVIEW_MODE">
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_1">
          <text>&gt; 0 and &gt;= 1</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_5">
          <text>1</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_REVIEW_MODE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="bproc_REVIEW_MODE_outputEntry_1">
          <text>"REVIEW_MODE"</text>
        </outputEntry>
        <annotationEntry id="bproc_REVIEW_MODE_annotation_1">
          <text>Billing run in review mode — not yet committed — Billing process was run in review (dry-run) mode: invoices have been generated for preview but not committed to customer accounts. Run is complete but results require approval before production processing.</text>
        </annotationEntry>
      </rule>
      <rule id="bproc_PARTIAL_FAILURE">
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_2">
          <text>&gt;= 1 and &lt; invoicesGenerated</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_PARTIAL_FAILURE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="bproc_PARTIAL_FAILURE_outputEntry_1">
          <text>"PARTIAL_FAILURE"</text>
        </outputEntry>
        <annotationEntry id="bproc_PARTIAL_FAILURE_annotation_1">
          <text>Billing run partial failure — some invoices failed — Billing run completed but a portion of invoices failed to generate. Failed count is greater than zero but less than total invoices generated. Revenue impact is partial — failed invoices need manual reprocessing.</text>
        </annotationEntry>
      </rule>
      <rule id="bproc_TIMEOUT_INCOMPLETE">
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_4">
          <text>&gt; 240</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_6">
          <text>&lt; invoicesGenerated</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_TIMEOUT_INCOMPLETE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="bproc_TIMEOUT_INCOMPLETE_outputEntry_1">
          <text>"TIMEOUT_INCOMPLETE"</text>
        </outputEntry>
        <annotationEntry id="bproc_TIMEOUT_INCOMPLETE_annotation_1">
          <text>Billing run timed out — incomplete processing — Billing run started but did not complete within the expected window (runCompleted=0), ran for an excessive duration, and the number of processed invoices is less than generated. System intervention required to resume or restart the run.</text>
        </annotationEntry>
      </rule>
      <rule id="bproc_ZERO_OUTPUT_ALERT">
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_7">
          <text>&gt;= 5</text>
        </inputEntry>
        <inputEntry id="bproc_ZERO_OUTPUT_ALERT_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <outputEntry id="bproc_ZERO_OUTPUT_ALERT_outputEntry_1">
          <text>"ZERO_OUTPUT_ALERT"</text>
        </outputEntry>
        <annotationEntry id="bproc_ZERO_OUTPUT_ALERT_annotation_1">
          <text>Billing run completed with zero invoices — configuration alert — Billing process run completed successfully (runCompleted=1) but generated zero invoices. This is unexpected for an entity with active customers and orders. Likely indicates a misconfiguration in billing period, order dates, or entity setup.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT9_TaxComplianceAssessment" name="DT9_TaxComplianceAssessment">
    <decisionTable id="DT9_TaxComplianceAssessment_table" hitPolicy="FIRST">
      <input id="DT9_TaxComplianceAssessment_input_1" label="taxExempt">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_1" typeRef="number">
          <text>taxExempt</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_2" label="exemptionCertificateValid">
