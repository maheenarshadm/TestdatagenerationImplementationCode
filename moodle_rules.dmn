          <text>"ATTEMPTS_EXHAUSTED_FAIL"</text>
        </outputEntry>
      </rule>
      <rule id="quiz_SINGLE_ATTEMPT_FAIL">
        <description>Only one attempt made, below pass mark - Student attempted quizzes only once and failed to meet pass mark. Multiple attempts are still available. May indicate disengagement or confidence issue rather than inability.</description>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_1">
          <text>&lt; 50</text>
        </inputEntry>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_4">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_SINGLE_ATTEMPT_FAIL_input_6">
          <text>-</text>
        </inputEntry>
        <outputEntry id="quiz_SINGLE_ATTEMPT_FAIL_output">
          <text>"SINGLE_ATTEMPT_FAIL"</text>
        </outputEntry>
      </rule>
      <rule id="quiz_NOT_ATTEMPTED">
        <description>No quiz attempts recorded - Student is enrolled, has been active long enough, but has not attempted any quizzes. Course has quizzes available (quizMaxAllowed &gt; 0). Engagement concern.</description>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_5">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="quiz_NOT_ATTEMPTED_input_6">
          <text>&gt;= 2</text>
        </inputEntry>
        <outputEntry id="quiz_NOT_ATTEMPTED_output">
          <text>"NOT_ATTEMPTED"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT4_CourseCompletionStatus" name="DT4_CourseCompletionStatus">
