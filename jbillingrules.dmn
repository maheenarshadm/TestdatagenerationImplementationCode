        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_4" label="daysToCertificateExpiry">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_4" typeRef="number">
          <text>daysToCertificateExpiry</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_5" label="manualReviewRequired">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_5" typeRef="number">
          <text>manualReviewRequired</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_6" label="deleted">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_6" typeRef="number">
          <text>deleted</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_7" label="taxRatePct">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_7" typeRef="number">
          <text>taxRatePct</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_8" label="taxJurisdictionConfigured">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_8" typeRef="number">
          <text>taxJurisdictionConfigured</text>
        </inputExpression>
      </input>
      <input id="DT9_TaxComplianceAssessment_input_9" label="userStatusId">
        <inputExpression id="DT9_TaxComplianceAssessment_inputExpression_9" typeRef="number">
          <text>userStatusId</text>
        </inputExpression>
      </input>
      <output id="DT9_TaxComplianceAssessment_output_1" name="taxComplianceStatus" label="taxComplianceStatus" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="tax_EXEMPT_VALID">
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_4">
          <text>&gt;= 0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_VALID_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="tax_EXEMPT_VALID_outputEntry_1">
          <text>"EXEMPT_VALID"</text>
        </outputEntry>
        <annotationEntry id="tax_EXEMPT_VALID_annotation_1">
          <text>Tax exempt customer — valid certificate on file — Customer has a valid tax exemption certificate, taxable amount is positive, certificate has not expired, and no manual review flag is present. Tax should not be charged.</text>
        </annotationEntry>
      </rule>
      <rule id="tax_EXEMPT_EXPIRING">
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_4">
          <text>[0..30]</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_EXEMPT_EXPIRING_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="tax_EXEMPT_EXPIRING_outputEntry_1">
          <text>"EXEMPT_EXPIRING"</text>
        </outputEntry>
        <annotationEntry id="tax_EXEMPT_EXPIRING_annotation_1">
          <text>Tax exemption certificate nearing expiry — Customer is tax exempt with a valid certificate, but the certificate expires within 30 days. Billing may proceed tax-exempt while renewal notification is sent.</text>
        </annotationEntry>
      </rule>
      <rule id="tax_STANDARD_TAXABLE">
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_7">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_STANDARD_TAXABLE_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="tax_STANDARD_TAXABLE_outputEntry_1">
          <text>"STANDARD_TAXABLE"</text>
        </outputEntry>
        <annotationEntry id="tax_STANDARD_TAXABLE_annotation_1">
          <text>Standard taxable transaction — Customer is not tax exempt, taxable amount is positive, jurisdiction is configured, and tax rate is available. Standard tax calculation can be applied.</text>
        </annotationEntry>
      </rule>
      <rule id="tax_MISSING_JURISDICTION">
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_8">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_MISSING_JURISDICTION_inputEntry_9">
          <text>1</text>
        </inputEntry>
        <outputEntry id="tax_MISSING_JURISDICTION_outputEntry_1">
          <text>"MISSING_JURISDICTION"</text>
        </outputEntry>
        <annotationEntry id="tax_MISSING_JURISDICTION_annotation_1">
          <text>Tax calculation blocked — missing jurisdiction — Taxable amount exists but the tax jurisdiction or tax rate configuration is missing. Billing should be held for tax setup correction.</text>
        </annotationEntry>
      </rule>
      <rule id="tax_REVIEW_REQUIRED">
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_3">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_5">
          <text>1</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tax_REVIEW_REQUIRED_inputEntry_9">
          <text>1</text>
        </inputEntry>
        <outputEntry id="tax_REVIEW_REQUIRED_outputEntry_1">
          <text>"REVIEW_REQUIRED"</text>
        </outputEntry>
        <annotationEntry id="tax_REVIEW_REQUIRED_annotation_1">
          <text>Tax compliance manual review required — Tax transaction has inconsistent exemption or jurisdiction data and has been flagged for manual review before invoice finalization.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT10_SubscriptionLifecycleAction" name="DT10_SubscriptionLifecycleAction">
    <decisionTable id="DT10_SubscriptionLifecycleAction_table" hitPolicy="FIRST">
      <input id="DT10_SubscriptionLifecycleAction_input_1" label="subscriptionStatusId">
        <inputExpression id="DT10_SubscriptionLifecycleAction_inputExpression_1" typeRef="number">
          <text>subscriptionStatusId</text>
        </inputExpression>
      </input>
      <input id="DT10_SubscriptionLifecycleAction_input_2" label="orderStatusId">
