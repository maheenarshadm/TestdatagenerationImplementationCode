        </inputExpression>
      </input>
      <input id="DT10_SubscriptionLifecycleAction_input_4" label="activeOrderLineCount">
        <inputExpression id="DT10_SubscriptionLifecycleAction_inputExpression_4" typeRef="number">
          <text>activeOrderLineCount</text>
        </inputExpression>
      </input>
      <input id="DT10_SubscriptionLifecycleAction_input_5" label="userStatusId">
        <inputExpression id="DT10_SubscriptionLifecycleAction_inputExpression_5" typeRef="number">
          <text>userStatusId</text>
        </inputExpression>
      </input>
      <input id="DT10_SubscriptionLifecycleAction_input_6" label="deleted">
        <inputExpression id="DT10_SubscriptionLifecycleAction_inputExpression_6" typeRef="number">
