        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="standing_SUSPENSION_RISK_output">
          <text>"SUSPENSION_RISK"</text>
        </outputEntry>
      </rule>
      <rule id="standing_INTEGRITY_HOLD">
        <description>Academic integrity hold — investigation pending - Student has grade overrides on multiple items AND high performance inconsistency (high avg quiz score but failed grade items). Pattern may indicate integrity concern. Standing frozen pending review.</description>
        <inputEntry id="standing_INTEGRITY_HOLD_input_1">
