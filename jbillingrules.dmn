      </input>
      <output id="DT3_OrderBillingReadiness_output_1" name="billingReadiness" label="billingReadiness" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="order_READY_POSTPAID">
        <inputEntry id="order_READY_POSTPAID_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_3">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_5">
          <text>1</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="order_READY_POSTPAID_inputEntry_11">
          <text>-</text>
