        <inputEntry id="standing_SUSPENSION_RISK_input_2">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_3">
          <text>&lt; 35</text>
        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_4">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="standing_SUSPENSION_RISK_input_6">
