        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_2">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_4">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="payout_ELIGIBLE_AUTO_inputEntry_5">
