  <decision id="DT10_ForumEngagementRisk" name="DT10_ForumEngagementRisk">
    <description>Decision table generated from JSON rules for DT10_ForumEngagementRisk.</description>
    <decisionTable id="DT10_ForumEngagementRisk_table" hitPolicy="FIRST">
      <input id="DT10_ForumEngagementRisk_input_1" label="forumPostCount">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_1" typeRef="number">
          <text>forumPostCount</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_2" label="daysSinceLastPost">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_2" typeRef="number">
