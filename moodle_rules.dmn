  <decision id="DT5_AcademicStanding" name="DT5_AcademicStanding">
    <description>Decision table generated from JSON rules for DT5_AcademicStanding.</description>
    <decisionTable id="DT5_AcademicStanding_table" hitPolicy="FIRST">
