      </input>
      <output id="DT5_AcademicStanding_output" label="academicStanding" name="academicStanding" typeRef="string"/>
      <rule id="standing_GOOD">
        <description>Good academic standing - Student is in good standing: passing final grade, no failed grade items, adequate module completion, assignment compliance, and active engagement (recent forum activity). Eligible for all privileges.</description>
        <inputEntry id="standing_GOOD_input_1">
          <text>&gt;= gradePassMark</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_2">
          <text>0</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_3">
          <text>&gt;= 70</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_5">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_6">
          <text>&lt;= 14</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_GOOD_input_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="standing_GOOD_output">
          <text>"GOOD"</text>
        </outputEntry>
      </rule>
      <rule id="standing_SATISFACTORY">
        <description>Satisfactory standing — passing but with concerns - Student is passing overall but has some deficiencies: one or two failed grade items, or low engagement, or late submissions. Passes the threshold but advisor flag is set.</description>
        <inputEntry id="standing_SATISFACTORY_input_1">
          <text>&gt;= gradePassMark</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_2">
          <text>&lt;= 2</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_3">
          <text>&gt;= 55</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_4">
          <text>&lt;= 1</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_8">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_SATISFACTORY_input_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="standing_SATISFACTORY_output">
          <text>"SATISFACTORY"</text>
        </outputEntry>
      </rule>
      <rule id="standing_PROBATION">
        <description>Academic probation — below pass threshold - Final grade is below pass mark but student is still engaged (some module completions, some forum activity). Placed on academic probation with remediation plan required.</description>
        <inputEntry id="standing_PROBATION_input_1">
          <text>&lt; gradePassMark</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_2">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_3">
          <text>&gt;= 35</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_8">
          <text>&gt;= 28</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_9">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="standing_PROBATION_input_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="standing_PROBATION_output">
          <text>"PROBATION"</text>
        </outputEntry>
      </rule>
      <rule id="standing_SUSPENSION_RISK">
        <description>Suspension risk — failing with disengagement - Student is failing academically and showing signs of disengagement: below pass grade, multiple failed items, low module completion, no forum posts, multiple missing assignments. At risk of suspension.</description>
        <inputEntry id="standing_SUSPENSION_RISK_input_1">
          <text>&lt; gradePassMark</text>
