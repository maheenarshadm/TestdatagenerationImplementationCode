<?xml version="1.0" ?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_jbilling_rules_extended" name="jBilling Redesigned Rules Extended" namespace="http://sarkars-workspace/dmn/jbilling-rules-extended" exporter="ChatGPT" exporterVersion="1.0">
  <decision id="DT1_CustomerCreditRisk" name="DT1_CustomerCreditRisk">
    <decisionTable id="DT1_CustomerCreditRisk_table" hitPolicy="FIRST">
      <input id="DT1_CustomerCreditRisk_input_1" label="userStatusId">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_1" typeRef="number">
          <text>userStatusId</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_2" label="balanceType">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_2" typeRef="number">
          <text>balanceType</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_3" label="dynamicBalance">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_3" typeRef="number">
          <text>dynamicBalance</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_4" label="overdueInvoiceCount">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_4" typeRef="number">
          <text>overdueInvoiceCount</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_5" label="failedPaymentCount">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_5" typeRef="number">
          <text>failedPaymentCount</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_6" label="autoPayment">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_6" typeRef="number">
          <text>autoPayment</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_7" label="accountLocked">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_7" typeRef="number">
          <text>accountLocked</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_8" label="creditLimitUtilisationPct">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_8" typeRef="number">
          <text>creditLimitUtilisationPct</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_9" label="creditLimit">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_9" typeRef="number">
          <text>creditLimit</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_10" label="activeOrderLineCount">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_10" typeRef="number">
          <text>activeOrderLineCount</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_11" label="maxDaysPastDue">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_11" typeRef="number">
          <text>maxDaysPastDue</text>
        </inputExpression>
      </input>
      <input id="DT1_CustomerCreditRisk_input_12" label="totalOverdueAmount">
        <inputExpression id="DT1_CustomerCreditRisk_inputExpression_12" typeRef="number">
          <text>totalOverdueAmount</text>
        </inputExpression>
      </input>
      <output id="DT1_CustomerCreditRisk_output_1" name="creditRisk" label="creditRisk" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="credit_GOOD_STANDING">
        <inputEntry id="credit_GOOD_STANDING_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_2">
          <text>3</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_3">
          <text>&lt; creditLimit</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_6">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_GOOD_STANDING_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="credit_GOOD_STANDING_outputEntry_1">
          <text>"GOOD_STANDING"</text>
        </outputEntry>
        <annotationEntry id="credit_GOOD_STANDING_annotation_1">
          <text>Customer in good credit standing — Customer has an active account with credit balance type, dynamic balance well within limit, no overdue invoices, no failed payments this cycle, and autopay configured. Eligible for service upgrades and credit limit increases.</text>
        </annotationEntry>
      </rule>
      <rule id="credit_APPROACHING_LIMIT">
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_2">
          <text>3</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_3">
          <text>&gt;= 0 and &lt; creditLimit</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_8">
          <text>&gt;= 80</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_9">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_APPROACHING_LIMIT_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="credit_APPROACHING_LIMIT_outputEntry_1">
          <text>"APPROACHING_LIMIT"</text>
        </outputEntry>
        <annotationEntry id="credit_APPROACHING_LIMIT_annotation_1">
          <text>Customer approaching credit limit — Customer is active with credit balance type but dynamic balance has consumed at least 80% of credit limit. No current overdue invoices but the trajectory warrants a soft alert before hard limit breach occurs.</text>
        </annotationEntry>
      </rule>
      <rule id="credit_LIMIT_BREACHED">
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_2">
          <text>3</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_3">
          <text>&gt; creditLimit</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_7">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_9">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_10">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_LIMIT_BREACHED_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="credit_LIMIT_BREACHED_outputEntry_1">
          <text>"LIMIT_BREACHED"</text>
        </outputEntry>
        <annotationEntry id="credit_LIMIT_BREACHED_annotation_1">
          <text>Credit limit exceeded — service throttling applies — Customer's dynamic balance exceeds their credit limit. Account is still active but service throttling rules apply. At least one active order line and no account lock yet — first breach response.</text>
        </annotationEntry>
      </rule>
      <rule id="credit_PREPAID_LOW">
        <inputEntry id="credit_PREPAID_LOW_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_2">
          <text>2</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_3">
          <text>[0..50[</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_10">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_PREPAID_LOW_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="credit_PREPAID_LOW_outputEntry_1">
          <text>"PREPAID_LOW"</text>
        </outputEntry>
        <annotationEntry id="credit_PREPAID_LOW_annotation_1">
          <text>Prepaid balance critically low — Prepaid customer whose balance has dropped to a critically low level. Has active order lines consuming balance, autopay is not configured to top up automatically. Service interruption imminent.</text>
        </annotationEntry>
      </rule>
      <rule id="credit_COLLECTIONS_ESCALATION">
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_2">
          <text>3</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_4">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_7">
          <text>1</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_11">
          <text>&gt;= 60</text>
        </inputEntry>
        <inputEntry id="credit_COLLECTIONS_ESCALATION_inputEntry_12">
          <text>&gt;= 500</text>
        </inputEntry>
        <outputEntry id="credit_COLLECTIONS_ESCALATION_outputEntry_1">
          <text>"COLLECTIONS_ESCALATION"</text>
        </outputEntry>
        <annotationEntry id="credit_COLLECTIONS_ESCALATION_annotation_1">
          <text>Collections escalation — multiple overdue invoices, locked account — Customer has multiple overdue invoices aged beyond 60 days, account is locked, and total overdue amount is substantial. Credit balance type with zero limit assigned. Requires collections team intervention.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT2_InvoiceSettlement" name="DT2_InvoiceSettlement">
    <decisionTable id="DT2_InvoiceSettlement_table" hitPolicy="FIRST">
      <input id="DT2_InvoiceSettlement_input_1" label="invoiceBalance">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_1" typeRef="number">
          <text>invoiceBalance</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_2" label="invoiceStatusId">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_2" typeRef="number">
          <text>invoiceStatusId</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_3" label="matchedPaymentCount">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_3" typeRef="number">
          <text>matchedPaymentCount</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_4" label="isVoided">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_4" typeRef="number">
          <text>isVoided</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_5" label="deleted">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_5" typeRef="number">
          <text>deleted</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_6" label="invoiceTotal">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_6" typeRef="number">
          <text>invoiceTotal</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_7" label="daysPastDue">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_7" typeRef="number">
          <text>daysPastDue</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_8" label="autoPayment">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_8" typeRef="number">
          <text>autoPayment</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_9" label="creditNoteLineCount">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_9" typeRef="number">
          <text>creditNoteLineCount</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_10" label="accountLocked">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_10" typeRef="number">
          <text>accountLocked</text>
        </inputExpression>
      </input>
      <input id="DT2_InvoiceSettlement_input_11" label="totalOverdueAmount">
        <inputExpression id="DT2_InvoiceSettlement_inputExpression_11" typeRef="number">
          <text>totalOverdueAmount</text>
        </inputExpression>
      </input>
      <output id="DT2_InvoiceSettlement_output_1" name="settlementStatus" label="settlementStatus" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="inv_FULLY_SETTLED">
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_3">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_6">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_FULLY_SETTLED_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <outputEntry id="inv_FULLY_SETTLED_outputEntry_1">
          <text>"FULLY_SETTLED"</text>
        </outputEntry>
        <annotationEntry id="inv_FULLY_SETTLED_annotation_1">
          <text>Invoice fully settled with matched payment — Invoice is fully paid with balance zero, has at least one matched payment record in payment_invoice, not voided or deleted, and was processed through a billing run. Clean settlement state.</text>
        </annotationEntry>
      </rule>
      <rule id="inv_PARTIAL_PAYMENT">
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_1">
          <text>&gt; 0 and &lt; invoiceTotal</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_3">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_7">
          <text>&lt;= 30</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_PARTIAL_PAYMENT_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <outputEntry id="inv_PARTIAL_PAYMENT_outputEntry_1">
          <text>"PARTIAL_PAYMENT"</text>
        </outputEntry>
        <annotationEntry id="inv_PARTIAL_PAYMENT_annotation_1">
          <text>Invoice partially paid — balance remaining — Invoice has been partially paid: balance is greater than zero but less than total. At least one payment is matched. Invoice is active and within dunning grace period. Requires follow-up payment.</text>
        </annotationEntry>
      </rule>
      <rule id="inv_OVERDUE_NO_PAYMENT">
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_1">
          <text>invoiceTotal</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_6">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_7">
          <text>&gt; 14</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_8">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_OVERDUE_NO_PAYMENT_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <outputEntry id="inv_OVERDUE_NO_PAYMENT_outputEntry_1">
          <text>"OVERDUE_NO_PAYMENT"</text>
        </outputEntry>
        <annotationEntry id="inv_OVERDUE_NO_PAYMENT_annotation_1">
          <text>Overdue invoice with no payment attempt — Invoice is overdue with full balance still outstanding, no payment has been matched or attempted, and the invoice has aged past the grace period. No autopay is configured. Dunning process should escalate.</text>
        </annotationEntry>
      </rule>
      <rule id="inv_DISPUTED_OVERDUE">
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_1">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_6">
          <text>&gt;= 100</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_7">
          <text>&gt; 30</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_9">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_DISPUTED_OVERDUE_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <outputEntry id="inv_DISPUTED_OVERDUE_outputEntry_1">
          <text>"DISPUTED_OVERDUE"</text>
        </outputEntry>
        <annotationEntry id="inv_DISPUTED_OVERDUE_annotation_1">
          <text>Disputed overdue invoice — credit note pending — Invoice is overdue and has an associated credit note or adjustment line (negative invoice line count &gt; 0), suggesting a billing dispute is in progress. Balance remains outstanding but write-off is not yet appropriate.</text>
        </annotationEntry>
      </rule>
      <rule id="inv_WRITEOFF_ELIGIBLE">
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_1">
          <text>invoiceTotal</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_7">
          <text>&gt;= 90</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_10">
          <text>1</text>
        </inputEntry>
        <inputEntry id="inv_WRITEOFF_ELIGIBLE_inputEntry_11">
          <text>&gt;= 300</text>
        </inputEntry>
        <outputEntry id="inv_WRITEOFF_ELIGIBLE_outputEntry_1">
          <text>"WRITEOFF_ELIGIBLE"</text>
        </outputEntry>
        <annotationEntry id="inv_WRITEOFF_ELIGIBLE_annotation_1">
          <text>Invoice eligible for write-off — Invoice is severely aged (90+ days past due), full balance outstanding, no payment ever matched, account is locked, and total overdue across all invoices is substantial. Meets criteria for bad-debt write-off.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="DT3_OrderBillingReadiness" name="DT3_OrderBillingReadiness">
