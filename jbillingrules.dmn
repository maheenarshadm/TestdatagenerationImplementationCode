        </inputExpression>
      </input>
      <input id="DT10_SubscriptionLifecycleAction_input_12" label="totalOverdueAmount">
        <inputExpression id="DT10_SubscriptionLifecycleAction_inputExpression_12" typeRef="number">
          <text>totalOverdueAmount</text>
        </inputExpression>
      </input>
      <output id="DT10_SubscriptionLifecycleAction_output_1" name="subscriptionAction" label="subscriptionAction" typeRef="string"/>
      <annotation name="Description"/>
      <rule id="sub_ACTIVATE_NEW">
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_3">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_4">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_5">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_ACTIVATE_NEW_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="sub_ACTIVATE_NEW_outputEntry_1">
          <text>"ACTIVATE_NEW"</text>
        </outputEntry>
        <annotationEntry id="sub_ACTIVATE_NEW_annotation_1">
          <text>Activate new subscription — Subscription order is approved, the start date has arrived, account is active, and at least one order line exists. Subscription can be activated.</text>
        </annotationEntry>
      </rule>
      <rule id="sub_RENEW_ACTIVE">
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_7">
          <text>&lt;= 0</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_8">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_9">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_10">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_RENEW_ACTIVE_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="sub_RENEW_ACTIVE_outputEntry_1">
          <text>"RENEW_ACTIVE"</text>
        </outputEntry>
        <annotationEntry id="sub_RENEW_ACTIVE_annotation_1">
          <text>Renew active subscription — Active subscription is due for renewal, renewal order exists, customer is current, and billing is not blocked. Renewal can be processed.</text>
        </annotationEntry>
      </rule>
      <rule id="sub_NOTIFY_EXPIRING">
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_7">
          <text>[1..14]</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_8">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_10">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_NOTIFY_EXPIRING_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="sub_NOTIFY_EXPIRING_outputEntry_1">
          <text>"NOTIFY_EXPIRING"</text>
        </outputEntry>
        <annotationEntry id="sub_NOTIFY_EXPIRING_annotation_1">
          <text>Notify customer of upcoming subscription expiry — Active subscription expires within 14 days, no renewal order exists, and account is not locked. Customer should receive an expiry notification.</text>
        </annotationEntry>
      </rule>
      <rule id="sub_SUSPEND_NONPAYMENT">
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_9">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_10">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_11">
          <text>&gt;= 45</text>
        </inputEntry>
        <inputEntry id="sub_SUSPEND_NONPAYMENT_inputEntry_12">
          <text>&gt;= 100</text>
        </inputEntry>
        <outputEntry id="sub_SUSPEND_NONPAYMENT_outputEntry_1">
          <text>"SUSPEND_NONPAYMENT"</text>
        </outputEntry>
        <annotationEntry id="sub_SUSPEND_NONPAYMENT_annotation_1">
          <text>Suspend subscription for non-payment — Active subscription belongs to a customer with overdue invoices beyond the formal warning period and unresolved balance. Subscription should be suspended.</text>
        </annotationEntry>
      </rule>
      <rule id="sub_CANCEL_EXPIRED">
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_6">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_7">
          <text>&lt; 0</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_8">
          <text>0</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_10">
          <text>1</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="sub_CANCEL_EXPIRED_inputEntry_12">
          <text>-</text>
        </inputEntry>
        <outputEntry id="sub_CANCEL_EXPIRED_outputEntry_1">
          <text>"CANCEL_EXPIRED"</text>
        </outputEntry>
        <annotationEntry id="sub_CANCEL_EXPIRED_annotation_1">
          <text>Cancel expired subscription with no renewal — Subscription has expired, no renewal order exists, and customer has been notified or suspended. Subscription can be cancelled to stop further service entitlement.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>