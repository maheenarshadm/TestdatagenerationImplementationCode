        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_8" label="daysSinceLastInstructorPost">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_8" typeRef="number">
          <text>daysSinceLastInstructorPost</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_9" label="totalForumDiscussions">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_9" typeRef="number">
          <text>totalForumDiscussions</text>
        </inputExpression>
      </input>
      <input id="DT10_ForumEngagementRisk_input_10" label="enrolledStudentCount">
        <inputExpression id="DT10_ForumEngagementRisk_inputExpr_10" typeRef="number">
          <text>enrolledStudentCount</text>
        </inputExpression>
      </input>
      <output id="DT10_ForumEngagementRisk_output" label="forumEngagement" name="forumEngagement" typeRef="string"/>
      <rule id="forum_HIGH_ENGAGEMENT">
        <description>High forum engagement - Student is highly engaged in course discussions, posting frequently and recently, with active module progress. Forum engagement supports learning progression.</description>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_1">
          <text>&gt;= 8</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_2">
          <text>&lt;= 7</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_3">
          <text>&gt;= 50</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_4">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_HIGH_ENGAGEMENT_input_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="forum_HIGH_ENGAGEMENT_output">
          <text>"HIGH_ENGAGEMENT"</text>
        </outputEntry>
      </rule>
      <rule id="forum_MODERATE_ENGAGEMENT">
        <description>Moderate forum engagement - Student has some forum activity, but posting is not frequent or recent enough to be considered highly engaged.</description>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_1">
          <text>&lt; 8</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_2">
          <text>&lt;= 21</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_3">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_MODERATE_ENGAGEMENT_input_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="forum_MODERATE_ENGAGEMENT_output">
          <text>"MODERATE_ENGAGEMENT"</text>
        </outputEntry>
      </rule>
      <rule id="forum_SILENT_ACTIVE">
        <description>Silent but academically active - Student does not participate in forums but is still progressing through modules, quizzes, or assignments. Adviser may encourage social engagement but academic risk is lower.</description>
        <inputEntry id="forum_SILENT_ACTIVE_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_3">
          <text>&gt;= 50</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_4">
          <text>&gt;= 14</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_5">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_6">
          <text>&lt;= 1</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_SILENT_ACTIVE_input_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="forum_SILENT_ACTIVE_output">
          <text>"SILENT_ACTIVE"</text>
        </outputEntry>
      </rule>
      <rule id="forum_DISENGAGED">
        <description>Forum disengaged with low academic activity - Student has no forum participation and low progress across modules and quizzes. Indicates likely disengagement and need for outreach.</description>
        <inputEntry id="forum_DISENGAGED_input_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_3">
          <text>&lt; 30</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_4">
          <text>&gt;= 21</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_6">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_DISENGAGED_input_10">
          <text>-</text>
        </inputEntry>
        <outputEntry id="forum_DISENGAGED_output">
          <text>"DISENGAGED"</text>
        </outputEntry>
      </rule>
      <rule id="forum_INSTRUCTOR_RESPONSE_NEEDED">
        <description>Instructor forum response needed - Student or class discussion volume is high, unanswered discussions are accumulating, and instructor has not posted recently. Requires instructor response.</description>
        <inputEntry id="forum_INSTRUCTOR_RESPONSE_NEEDED_input_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_INSTRUCTOR_RESPONSE_NEEDED_input_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="forum_INSTRUCTOR_RESPONSE_NEEDED_input_3">
          <text>-</text>
