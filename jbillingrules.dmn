      <rule id="dun_CURRENT">
        <inputEntry id="dun_CURRENT_inputEntry_1">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_4">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_CURRENT_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="dun_CURRENT_outputEntry_1">
          <text>"CURRENT"</text>
        </outputEntry>
        <annotationEntry id="dun_CURRENT_annotation_1">
          <text>Account current — no dunning action — Customer has no overdue invoices, account is active, and all invoices have been paid or are within payment terms. No dunning action required. Credit standing is maintained.</text>
        </annotationEntry>
      </rule>
      <rule id="dun_SOFT_REMINDER">
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_1">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_6">
          <text>[1..14]</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_7">
          <text>&lt; 500</text>
        </inputEntry>
        <inputEntry id="dun_SOFT_REMINDER_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="dun_SOFT_REMINDER_outputEntry_1">
          <text>"SOFT_REMINDER"</text>
        </outputEntry>
        <annotationEntry id="dun_SOFT_REMINDER_annotation_1">
          <text>Soft reminder — early overdue within grace period — Customer has one or more overdue invoices but within the grace period (1–14 days past due). Account is not yet locked and amount is modest. A soft reminder notification is appropriate.</text>
        </annotationEntry>
      </rule>
      <rule id="dun_FORMAL_WARNING">
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_1">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_2">
          <text>1</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_3">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_6">
          <text>[15..45]</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_7">
          <text>&gt;= 100</text>
        </inputEntry>
        <inputEntry id="dun_FORMAL_WARNING_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="dun_FORMAL_WARNING_outputEntry_1">
          <text>"FORMAL_WARNING"</text>
        </outputEntry>
        <annotationEntry id="dun_FORMAL_WARNING_annotation_1">
          <text>Formal warning — overdue beyond grace period — Customer has invoices 15–45 days past due, account is still active but a formal warning letter is required. Amount owed is significant enough to warrant formal communication and payment plan offer.</text>
        </annotationEntry>
      </rule>
      <rule id="dun_SERVICE_SUSPENSION">
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_1">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_2">
          <text>2</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_6">
          <text>[46..90]</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_7">
          <text>&gt;= 200</text>
        </inputEntry>
        <inputEntry id="dun_SERVICE_SUSPENSION_inputEntry_8">
          <text>1</text>
        </inputEntry>
        <outputEntry id="dun_SERVICE_SUSPENSION_outputEntry_1">
          <text>"SERVICE_SUSPENSION"</text>
        </outputEntry>
        <annotationEntry id="dun_SERVICE_SUSPENSION_annotation_1">
          <text>Service suspension — prolonged non-payment — Customer has been in arrears for 46–90 days, account is suspended (userStatusId=2), ageing configuration has triggered suspension, and total overdue amount is substantial. Service is cut until payment received.</text>
        </annotationEntry>
      </rule>
      <rule id="dun_COLLECTIONS_REFERRAL">
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_1">
          <text>&gt;= 3</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_2">
          <text>2</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_3">
          <text>1</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_5">
          <text>0</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_6">
          <text>&gt; 90</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_7">
          <text>&gt;= 500</text>
        </inputEntry>
        <inputEntry id="dun_COLLECTIONS_REFERRAL_inputEntry_8">
          <text>-</text>
        </inputEntry>
        <outputEntry id="dun_COLLECTIONS_REFERRAL_outputEntry_1">
          <text>"COLLECTIONS_REFERRAL"</text>
        </outputEntry>
        <annotationEntry id="dun_COLLECTIONS_REFERRAL_annotation_1">
          <text>Collections referral — terminal dunning stage — Customer has been suspended for over 90 days, account is locked, multiple invoices severely overdue, and total owed exceeds the collections threshold. Case is referred to external collections agency.</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
